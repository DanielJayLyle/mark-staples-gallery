# Public site address (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://markys11.co.uk

# Sanity CMS (create a free project at sanity.io/manage). Leave empty to use the sample content in content/seed.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: the dataset is private because it stores enquiries
SANITY_API_READ_TOKEN=
# Token with Editor rights, so enquiries can be saved into the Studio
SANITY_API_WRITE_TOKEN=
# Any long random string; paste the same value into the Sanity webhook so new artworks appear instantly
SANITY_REVALIDATE_SECRET=

# Resend (resend.com) for enquiry emails
RESEND_API_KEY=
ENQUIRY_TO=you@example.com
ENQUIRY_FROM=Mark Staples <enquiries@markys11.co.uk>
